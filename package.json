{
  "name": "magnify-admin-api",
  "version": "1.0.0",
  "description": "NestJS backend API",
  "author": "Vaishnavi",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "license": "UNLICENSED",
  "scripts": {
    "build": "node --max-old-space-size=512 ./node_modules/.bin/nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node --max-old-space-size=512 dist/main",
    "dev": "nest start --watch",
    "debug": "nest start --debug --watch",
    "start:debug": "nest start --debug --watch",
    "prod": "node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:e2e:report": "jest --json --outputFile=jest-report.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1093.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@types/nodemailer": "^8.0.1",
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "mongoose": "^9.8.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.18.0",
    "rxjs": "^7.8.2",
    "supertest": "^7.2.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/passport-jwt": "^4.0.1"
  }
}
