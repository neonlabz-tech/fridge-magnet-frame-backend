{
  "info": {
    "name": "Magnify Admin API",
    "description": "Postman collection for the NestJS backend. Update the baseUrl or JWT token as needed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "jwtToken",
      "value": "PASTE_YOUR_JWT_HERE",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"123456\",\n  \"phoneNumber\": \"9876543210\",\n  \"customerAddress\": \"123 Main Street, Bengaluru\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "forgot-password"]
            }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"RESET_TOKEN_HERE\",\n  \"password\": \"newPassword123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/reset-password",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "reset-password"]
            }
          }
        },
        {
          "name": "Activate Account",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/auth/activate?token=ACTIVATION_TOKEN_HERE",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "activate"],
              "query": [{"key": "token", "value": "ACTIVATION_TOKEN_HERE"}]
            }
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{jwtToken}}"}],
            "url": {
              "raw": "{{baseUrl}}/auth/profile",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "profile"]
            }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PATCH",
            "header": [
              {"key": "Authorization", "value": "Bearer {{jwtToken}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"John Updated\",\n  \"phoneNumber\": \"9988776655\",\n  \"customerAddress\": \"456 Updated Street, Mysuru\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/profile",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "profile"]
            }
          }
        },
        {
          "name": "Upload Avatar",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{jwtToken}}"}],
            "body": {
              "mode": "formdata",
              "formdata": [
                {"key": "avatar", "type": "file", "src": []}
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/auth/profile/avatar",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "profile", "avatar"]
            }
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {"key": "productName", "value": "Magnet Frame", "type": "text"},
                {"key": "productId", "value": "MAG-1001", "type": "text"},
                {"key": "stock", "value": "25", "type": "text"},
                {"key": "price", "value": "799", "type": "text"},
                {"key": "imagecount", "value": "3", "type": "text"},
                {"key": "description", "value": "Premium magnetic fridge frame.", "type": "text"},
                {"key": "personalization", "value": "[\"Black\",\"White\",\"Silver\"]", "type": "text"},
                {"key": "primaryImage", "type": "file", "src": []},
                {"key": "galleryImages", "type": "file", "src": []},
                {"key": "personalizationImages", "type": "file", "src": []}
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            }
          }
        },
        {
          "name": "Get All Products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products?page=1&limit=10&search=frame&category=home&status=active&minPrice=100&maxPrice=1000",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                {"key": "page", "value": "1"},
                {"key": "limit", "value": "10"},
                {"key": "search", "value": "frame"},
                {"key": "category", "value": "home"},
                {"key": "status", "value": "active"},
                {"key": "minPrice", "value": "100"},
                {"key": "maxPrice", "value": "1000"}
              ]
            }
          }
        },
        {
          "name": "Get Product By Id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products/PRODUCT_ID_HERE",
              "host": ["{{baseUrl}}"],
              "path": ["products", "PRODUCT_ID_HERE"]
            }
          }
        },
        {
          "name": "Get Product Stock Log",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products/PRODUCT_ID_HERE/stock-log",
              "host": ["{{baseUrl}}"],
              "path": ["products", "PRODUCT_ID_HERE", "stock-log"]
            }
          }
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PUT",
            "body": {
              "mode": "formdata",
              "formdata": [
                {"key": "productName", "value": "Updated Magnet Frame", "type": "text"},
                {"key": "stock", "value": "40", "type": "text"},
                {"key": "price", "value": "899", "type": "text"},
                {"key": "description", "value": "Updated product description.", "type": "text"},
                {"key": "personalization", "value": "[\"Black\",\"Gold\"]", "type": "text"},
                {"key": "primaryImage", "type": "file", "src": []},
                {"key": "personalizationImages", "type": "file", "src": []}
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/products/PRODUCT_ID_HERE",
              "host": ["{{baseUrl}}"],
              "path": ["products", "PRODUCT_ID_HERE"]
            }
          }
        },
        {
          "name": "Add Gallery Images",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {"key": "galleryImages", "type": "file", "src": []}
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/products/PRODUCT_ID_HERE/gallery",
              "host": ["{{baseUrl}}"],
              "path": ["products", "PRODUCT_ID_HERE", "gallery"]
            }
          }
        },
        {
          "name": "Delete Product",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/products/PRODUCT_ID_HERE",
              "host": ["{{baseUrl}}"],
              "path": ["products", "PRODUCT_ID_HERE"]
            }
          }
        },
        {
          "name": "Delete Product Image",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/products/PRODUCT_ID_HERE/image/PUBLIC_IMAGE_ID_HERE",
              "host": ["{{baseUrl}}"],
              "path": ["products", "PRODUCT_ID_HERE", "image", "PUBLIC_IMAGE_ID_HERE"]
            }
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"ORD-1001\",\n  \"customerName\": \"Jane Smith\",\n  \"customerId\": \"CUST-001\",\n  \"email\": \"jane@example.com\",\n  \"phone\": \"9876543210\",\n  \"qty\": 2,\n  \"totalValue\": 1598,\n  \"shippingAddress\": \"78 Market Road, Bengaluru\",\n  \"district\": \"Bengaluru\",\n  \"adminNote\": \"Rush delivery\",\n  \"items\": [\n    {\n      \"productId\": \"MAG-1001\",\n      \"name\": \"Magnet Frame\",\n      \"price\": 799,\n      \"quantity\": 2,\n      \"image\": \"https://example.com/frame.jpg\",\n      \"frameType\": \"Classic\",\n      \"colorOption\": \"Black\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            }
          }
        },
        {
          "name": "Get All Orders",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/orders?status=pending&search=jane",
              "host": ["{{baseUrl}}"],
              "path": ["orders"],
              "query": [
                {"key": "status", "value": "pending"},
                {"key": "search", "value": "jane"}
              ]
            }
          }
        },
        {
          "name": "Get Order By Id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/orders/ORDER_ID_HERE",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "ORDER_ID_HERE"]
            }
          }
        },
        {
          "name": "Update Order Status",
          "request": {
            "method": "PATCH",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"processing\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/ORDER_ID_HERE/status",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "ORDER_ID_HERE", "status"]
            }
          }
        },
        {
          "name": "Delete Order",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/orders/ORDER_ID_HERE",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "ORDER_ID_HERE"]
            }
          }
        },
        {
          "name": "Get Receipt Status",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/orders/ORD-1001/receipt/status",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "ORD-1001", "receipt", "status"]
            }
          }
        },
        {
          "name": "Download Receipt",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/orders/ORD-1001/receipt",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "ORD-1001", "receipt"]
            }
          }
        }
      ]
    },
    {
      "name": "Customers",
      "item": [
        {
          "name": "Create Customer",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Asha Kumar\",\n  \"emailAddress\": \"asha@example.com\",\n  \"phoneNumber\": \"9876543210\",\n  \"customerAddress\": \"10 Temple Road, Mangalore\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customers",
              "host": ["{{baseUrl}}"],
              "path": ["customers"]
            }
          }
        },
        {
          "name": "Get All Customers",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/customers?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["customers"],
              "query": [
                {"key": "page", "value": "1"},
                {"key": "limit", "value": "10"}
              ]
            }
          }
        },
        {
          "name": "Get Customer By Email",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/customers/by-email/asha@example.com",
              "host": ["{{baseUrl}}"],
              "path": ["customers", "by-email", "asha@example.com"]
            }
          }
        },
        {
          "name": "Get Customer By Id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/customers/CUSTOMER_ID_HERE",
              "host": ["{{baseUrl}}"],
              "path": ["customers", "CUSTOMER_ID_HERE"]
            }
          }
        },
        {
          "name": "Update Customer",
          "request": {
            "method": "PATCH",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Asha Updated\",\n  \"phoneNumber\": \"9988776655\",\n  \"customerAddress\": \"20 New Road, Mangalore\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customers/CUSTOMER_ID_HERE",
              "host": ["{{baseUrl}}"],
              "path": ["customers", "CUSTOMER_ID_HERE"]
            }
          }
        },
        {
          "name": "Update Customer Status",
          "request": {
            "method": "PATCH",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isActive\": true,\n  \"source\": \"customer\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customers/CUSTOMER_ID_HERE/status",
              "host": ["{{baseUrl}}"],
              "path": ["customers", "CUSTOMER_ID_HERE", "status"]
            }
          }
        },
        {
          "name": "Delete Customer",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/customers/CUSTOMER_ID_HERE",
              "host": ["{{baseUrl}}"],
              "path": ["customers", "CUSTOMER_ID_HERE"]
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{jwtToken}}"}],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["users"]
            }
          }
        }
      ]
    },
    {
      "name": "Contact",
      "item": [
        {
          "name": "Send Contact Message",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Buyer\",\n  \"email\": \"buyer@example.com\",\n  \"subject\": \"Product inquiry\",\n  \"message\": \"I want to know about custom magnet frames.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/contact",
              "host": ["{{baseUrl}}"],
              "path": ["contact"]
            }
          }
        }
      ]
    },
    {
      "name": "Feedback",
      "item": [
        {
          "name": "Create Feedback",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Customer\",\n  \"email\": \"customer@example.com\",\n  \"message\": \"Great ordering experience.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/feedback",
              "host": ["{{baseUrl}}"],
              "path": ["feedback"]
            }
          }
        },
        {
          "name": "Get All Feedback",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/feedback",
              "host": ["{{baseUrl}}"],
              "path": ["feedback"]
            }
          }
        }
      ]
    }
  ]
}
